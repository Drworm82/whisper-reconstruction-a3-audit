{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "whisperx-continuous-test",
  "description": "Fixture para test de transcripción continua realista",
  "type": "object",
  "properties": {
    "Segments": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Segment"
      }
    }
  },
  "definitions": {
    "Segment": {
      "type": "object",
      "properties": {
        "Start": { "type": "number" },
        "End": { "type": "number" },
        "Tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "Word": { "type": "string" },
              "Start": { "type": "number" },
              "End": { "type": "number" }
            },
            "required": ["Word", "Start", "End"]
          }
        }
      },
      "required": ["Start", "End", "Tokens"]
    }
  },
  "required": ["Segments"]
}